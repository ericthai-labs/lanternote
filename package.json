{
  "name": "lanternote",
  "productName": "Lanternote",
  "version": "1.17.1",
  "description": "Lanternote — Markdown notes with links, graph and editing, for very large vaults",
  "main": "main.js",
  "author": "Eric Thai - Thai Ba Hoa",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable zip",
    "dist:mac": "electron-builder --mac zip",
    "dist:linux": "electron-builder --linux AppImage",
    "vendor": "node scripts/vendor.js && node scripts/notices.js",
    "bench": "node scripts/bench-index.js",
    "postinstall": "node scripts/vendor.js && node scripts/notices.js",
    "predist:win": "node scripts/check-changelog.js",
    "predist:mac": "node scripts/check-changelog.js",
    "predist:linux": "node scripts/check-changelog.js",
    "check-changelog": "node scripts/check-changelog.js",
    "media": "node scripts/make-media.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@cosmos.gl/graph": "^3.4.2",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "3.1.6",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "^0.28.2",
    "marked": "12.0.2",
    "mermaid": "10.9.1"
  },
  "build": {
    "appId": "com.lanternote.app",
    "productName": "Lanternote",
    "files": [
      "main.js",
      "preload.js",
      "indexer.js",
      "layout-worker.js",
      "search-index.js",
      "mcp/**",
      "src/**",
      "package.json",
      "CHANGELOG.md"
    ],
    "win": {
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Lanternote-${version}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Viewer"
      }
    ],
    "copyright": "Copyright © 2026 Eric Thai - Thai Ba Hoa. PolyForm Noncommercial 1.0.0.",
    "extraResources": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ]
  },
  "copyright": "Copyright © 2026 Eric Thai - Thai Ba Hoa. PolyForm Noncommercial 1.0.0."
}
